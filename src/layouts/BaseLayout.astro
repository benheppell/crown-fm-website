---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Override the OG/canonical path. Defaults to "/". */
  pathname?: string;
}

const {
  title,
  description = "Hard FM, soft FM and renovations across London & the Southeast. One team, every trade. 24/7 response. CHAS, SafeContractor, NICEIC.",
  pathname = "/",
} = Astro.props;

const canonical = new URL(pathname, Astro.site ?? "https://www.crown-fm.co.uk").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <title>{title}</title>
  </head>
  <body>
    <!-- ====== TOP BAR ====== -->
    <div class="topbar">
      <div class="container">
        <a href="mailto:info@crown-fm.co.uk">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          info@crown-fm.co.uk
        </a>
        <a href="tel:01276582081">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          01276 582 081
        </a>
        <a href="/">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          www.crown-fm.co.uk
        </a>
      </div>
    </div>

    <!-- ====== HEADER ====== -->
    <header class="header">
      <div class="container">
        <a href="/" class="logo" aria-label="Crown Facilities Management — home">
          <span class="logo__image" aria-hidden="true"></span>
        </a>

        <ul class="nav" id="mainNav">
          <li><a href="/#about">Who We Are</a></li>
          <li><a href="/#services">Soft FM</a></li>
          <li><a href="/#services">Hard FM</a></li>
          <li><a href="/#services">Renovations</a></li>
          <li><a href="/#contact" class="nav__cta">Get In Touch</a></li>
        </ul>

        <div class="mobile-toggle" onclick="toggleNav()">
          <span></span><span></span><span></span>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ====== FOOTER ====== -->
    <footer class="footer">
      <div class="container">
        <div class="footer__grid">
          <div class="footer__brand">
            <a href="/" class="logo" aria-label="Crown Facilities Management — home">
              <span class="logo__image footer__logo" aria-hidden="true"></span>
            </a>
            <p>Complete facilities management, construction, and renovation services. One team. Every trade. Built around standards.</p>
          </div>
          <div class="footer__links">
            <h4>Services</h4>
            <a href="/#services">Commercial Cleaning</a>
            <a href="/#services">Reactive Maintenance</a>
            <a href="/#services">Planned Maintenance</a>
            <a href="/#services">Fire Safety</a>
            <a href="/#services">Air Conditioning</a>
            <a href="/#services">Renovations</a>
          </div>
          <div class="footer__links">
            <h4>Company</h4>
            <a href="/#about">Who We Are</a>
            <a href="/#services">Soft FM</a>
            <a href="/#services">Hard FM</a>
            <a href="/#services">Renovations</a>
            <a href="/#faq">FAQ</a>
            <a href="/#contact">Contact</a>
          </div>
          <div class="footer__contact">
            <h4>Get In Touch</h4>
            <p><a href="tel:01276582081">01276 582 081</a></p>
            <p><a href="mailto:info@crown-fm.co.uk">info@crown-fm.co.uk</a></p>
            <p><a href="/">www.crown-fm.co.uk</a></p>
          </div>
        </div>
        <div class="footer__bottom">
          &copy; {new Date().getFullYear()} Crown Facilities Management. All rights reserved.
        </div>
      </div>
    </footer>

    <script src="/js/main.js" is:inline></script>
  </body>
</html>
