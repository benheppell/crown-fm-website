---
import BaseLayout from "../layouts/BaseLayout.astro";

// Form submissions are handled by Netlify Forms. No third-party endpoint
// is needed — Netlify detects `data-netlify="true"` in the built static
// HTML during post-processing and saves submissions under
// https://app.netlify.com/sites/<site>/forms.
---

<BaseLayout
  title="Contact — Crown FM"
  description="Get in touch with Crown FM for a facilities management proposal, callout, or to review your current contract."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <p class="text-sm font-semibold tracking-wide uppercase text-brand-700">
      Contact
    </p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-brand-900 max-w-3xl">
      Tell us about your building.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600">
      Drop us a few details and a named account manager will come back to
      you within one working day. For active emergencies, call us — the form
      isn't monitored out of hours.
    </p>
  </section>

  <section class="border-t border-slate-200 bg-brand-50">
    <div class="mx-auto max-w-6xl px-4 py-16 grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-2 space-y-8">
        <div>
          <h2 class="text-sm font-semibold tracking-wide uppercase text-brand-700">
            New business
          </h2>
          <p class="mt-2 text-slate-700">
            <a href="mailto:hello@crownfm.example" class="hover:text-brand-700"
              >hello@crownfm.example</a
            >
          </p>
          <p class="mt-1 text-slate-700">
            <a href="tel:+441234567890" class="hover:text-brand-700"
              >+44 1234 567 890</a
            >
          </p>
        </div>
        <div>
          <h2 class="text-sm font-semibold tracking-wide uppercase text-brand-700">
            Emergency callouts (existing clients)
          </h2>
          <p class="mt-2 text-slate-700">
            <a href="tel:+441234567891" class="hover:text-brand-700"
              >+44 1234 567 891</a
            >
          </p>
          <p class="mt-1 text-sm text-slate-500">
            24 hours a day, 365 days a year.
          </p>
        </div>
        <div>
          <h2 class="text-sm font-semibold tracking-wide uppercase text-brand-700">
            Office
          </h2>
          <address class="mt-2 text-slate-700 not-italic">
            Crown FM Ltd<br />
            <span class="text-slate-500">Address line 1</span><br />
            <span class="text-slate-500">Town, Postcode</span>
          </address>
        </div>
      </div>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="lg:col-span-3 bg-white border border-slate-200 rounded-lg p-6 sm:p-8 space-y-5"
      >
        <!-- Required so Netlify knows which form this is. -->
        <input type="hidden" name="form-name" value="contact" />
        <!-- Honeypot: real users leave this blank, bots fill it. Netlify silently drops those submissions. -->
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-brand-900"
              >Your name</label
            >
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
            />
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-brand-900"
              >Company</label
            >
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="email" class="block text-sm font-medium text-brand-900"
              >Email</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
            />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-brand-900"
              >Phone <span class="text-slate-400">(optional)</span></label
            >
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
            />
          </div>
        </div>

        <div>
          <label for="enquiry" class="block text-sm font-medium text-brand-900"
            >What can we help with?</label
          >
          <select
            id="enquiry"
            name="enquiry"
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
          >
            <option>Reviewing our current FM contract</option>
            <option>New site / new contract</option>
            <option>One-off project or small works</option>
            <option>Compliance / statutory testing</option>
            <option>Something else</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-brand-900"
            >A few details</label
          >
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
          ></textarea>
        </div>

        <div class="flex items-center justify-between gap-4 flex-wrap">
          <p class="text-xs text-slate-500">
            We'll only use these details to reply to your enquiry.
          </p>
          <button
            type="submit"
            class="inline-flex items-center rounded-md bg-brand-700 px-5 py-3 text-white font-medium hover:bg-brand-900 transition"
            >Send enquiry</button
          >
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
