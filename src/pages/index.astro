---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Crown FM — Facilities Management">
  <section class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <p class="text-sm font-semibold tracking-wide uppercase text-brand-700">
      Facilities management
    </p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-brand-900 max-w-3xl">
      Buildings that work, so your team can get on with theirs.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600">
      Crown FM looks after the mechanical, electrical, and fabric of
      commercial buildings — planned maintenance, reactive callouts, and
      statutory compliance, delivered by directly-employed engineers and
      backed by a single point of contact.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact"
        class="inline-flex items-center rounded-md bg-brand-700 px-5 py-3 text-white font-medium hover:bg-brand-900 transition"
        >Request a quote</a
      >
      <a
        href="/services"
        class="inline-flex items-center rounded-md border border-slate-300 px-5 py-3 font-medium hover:border-slate-400 transition"
        >See our services</a
      >
    </div>
  </section>

  <section class="border-t border-slate-200 bg-brand-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-brand-900">What we do</h2>
      <div class="mt-10 grid sm:grid-cols-3 gap-8">
        <div>
          <h3 class="font-semibold text-brand-900">Planned maintenance</h3>
          <p class="mt-2 text-slate-600 text-sm leading-relaxed">
            Scheduled servicing of HVAC, electrical, water systems and
            building fabric. Asset-registered, frequency-driven, fully
            documented.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-brand-900">Reactive callouts</h3>
          <p class="mt-2 text-slate-600 text-sm leading-relaxed">
            One number, 24/7. Engineers on-site within agreed SLAs for
            heating, plumbing, electrical and fabric failures.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-brand-900">Compliance &amp; inspections</h3>
          <p class="mt-2 text-slate-600 text-sm leading-relaxed">
            Statutory testing — gas safety, fixed wiring, fire, water hygiene
            — logged against your assets and audit-ready on demand.
          </p>
        </div>
      </div>
      <p class="mt-10 text-sm">
        <a href="/services" class="text-brand-700 font-medium hover:text-brand-900"
          >Full service list →</a
        >
      </p>
    </div>
  </section>

  <section class="border-t border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-16 grid md:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-brand-900">
          Built for facilities and office managers who are tired of chasing.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Most FM contracts mean juggling sub-contractors, missed SLAs, and
          paperwork that doesn't add up at audit time. Crown FM replaces that
          with one team, one schedule, and one point of contact who actually
          picks up the phone.
        </p>
      </div>
      <dl class="grid grid-cols-2 gap-6">
        <div class="border-l-2 border-brand-500 pl-4">
          <dt class="text-3xl font-bold text-brand-900">24/7</dt>
          <dd class="mt-1 text-sm text-slate-600">Emergency response cover</dd>
        </div>
        <div class="border-l-2 border-brand-500 pl-4">
          <dt class="text-3xl font-bold text-brand-900">100%</dt>
          <dd class="mt-1 text-sm text-slate-600">Directly-employed engineers</dd>
        </div>
        <div class="border-l-2 border-brand-500 pl-4">
          <dt class="text-3xl font-bold text-brand-900">1</dt>
          <dd class="mt-1 text-sm text-slate-600">Account manager per client</dd>
        </div>
        <div class="border-l-2 border-brand-500 pl-4">
          <dt class="text-3xl font-bold text-brand-900">Audit-ready</dt>
          <dd class="mt-1 text-sm text-slate-600">Compliance records, always</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-brand-900">
    <div class="mx-auto max-w-6xl px-4 py-16 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">
          Reviewing your FM contract?
        </h2>
        <p class="mt-3 text-brand-100 max-w-xl">
          We're happy to look over your current schedule of works and tell you
          honestly whether we can improve on it. No obligation.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex items-center rounded-md bg-white px-5 py-3 text-brand-900 font-medium hover:bg-brand-50 transition"
        >Talk to us</a
      >
    </div>
  </section>
</BaseLayout>
